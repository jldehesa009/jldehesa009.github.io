<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mi Refugio - Primeros Auxilios Emocionales</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>

    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        /* Animación para 'El Río' (Defusión Cognitiva) */
        @keyframes washAway {
            0% { opacity: 1; transform: translateX(0) scale(1); filter: blur(0px); color: #164e63; }
            50% { opacity: 0.8; filter: blur(4px); color: #0891b2; }
            100% { opacity: 0; transform: translateX(100px) scale(0.9); filter: blur(10px); }
        }
        .animate-wash { 
            animation: washAway 2s cubic-bezier(0.4, 0, 0.2, 1) forwards; 
            pointer-events: none;
        }

        /* Animación para los pétalos del 'Macuilí' */
        @keyframes fall {
            0% { transform: translateY(-10vh) rotate(0deg) translateX(0); opacity: 0; }
            10% { opacity: 1; }
            100% { transform: translateY(100vh) rotate(360deg) translateX(50px); opacity: 0; }
        }
        .petal { 
            position: absolute; 
            animation: fall linear infinite; 
            cursor: pointer; 
            transition: transform 0.2s, filter 0.2s; 
            color: #f9a8d4; /* pink-300 */
        }
        .petal:hover { 
            transform: scale(1.3); 
            color: #ec4899; /* pink-500 */
            filter: drop-shadow(0 0 5px rgba(236,72,153,0.5));
        }

        /* Animación flotante genérica */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(5deg); }
        }
        .animate-float { animation: float 6s ease-in-out infinite; }

        /* Ocultar scrollbar pero permitir scroll */
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

        /* Transición suave del fondo general */
        body { transition: background-color 0.7s ease, color 0.7s ease; }
    </style>
</head>

<body class="bg-amber-50 dark:bg-stone-950 font-sans text-stone-800 dark:text-stone-200 antialiased min-h-screen flex flex-col md:flex-row pb-20 md:pb-0 transition-colors duration-700" id="main-body">

    <button onclick="toggleTheme()" class="fixed bottom-24 right-4 z-50 bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-700 dark:text-amber-300 p-3 rounded-full shadow-md transition-transform hover:scale-110 border border-stone-300 dark:border-stone-600" aria-label="Cambiar Tema">
        <i data-lucide="moon" id="theme-icon" class="w-6 h-6"></i>
    </button>

    <button onclick="toggleSosModal(true)" class="fixed top-4 right-4 z-50 bg-red-500 hover:bg-red-600 dark:bg-red-600 dark:hover:bg-red-700 text-white p-3 rounded-full shadow-[0_0_15px_rgba(239,68,68,0.5)] flex items-center justify-center transition-transform hover:scale-110" aria-label="Ayuda de Emergencia">
        <i data-lucide="phone" class="w-6 h-6 animate-pulse"></i>
    </button>

    <div id="sos-modal" class="hidden fixed inset-0 bg-stone-900/60 z-[60] flex items-center justify-center p-4 backdrop-blur-sm transition-opacity duration-300">
        <div class="bg-white dark:bg-stone-900 rounded-3xl p-6 w-full max-w-md shadow-2xl relative transform transition-all scale-95 opacity-0 border dark:border-stone-700" id="sos-content">
            <button onclick="toggleSosModal(false)" class="absolute top-4 right-4 text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 bg-stone-100 dark:bg-stone-800 rounded-full p-1 transition-colors">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
            <div class="flex items-center space-x-3 mb-2 text-red-600 dark:text-red-400">
                <i data-lucide="alert-triangle" class="w-8 h-8"></i>
                <h2 class="text-2xl font-bold dark:text-white">Directorio de Apoyo</h2>
            </div>
            <p class="mb-6 text-stone-600 dark:text-stone-400 text-sm">Está bien pedir ayuda. Hay personas en Tabasco listas para escucharte sin juzgar.</p>
            
            <div class="space-y-3">
                <a href="tel:8009112000" class="block w-full bg-gradient-to-r from-red-50 to-orange-50 dark:from-red-900/20 dark:to-orange-900/20 p-4 rounded-2xl border border-red-100 dark:border-red-900/30 flex items-center justify-between hover:shadow-md transition">
                    <div>
                        <h3 class="font-bold text-red-800 dark:text-red-300 text-lg">Línea de la Vida Nacional</h3>
                        <p class="text-red-600 dark:text-red-400/80 text-sm">24/7. Gratuito y confidencial.</p>
                    </div>
                    <div class="bg-white dark:bg-stone-800 p-2 rounded-full shadow-sm"><i data-lucide="phone" class="text-red-600 dark:text-red-400 w-5 h-5"></i></div>
                </a>
                <div class="bg-emerald-50 dark:bg-emerald-900/20 p-4 rounded-2xl border border-emerald-100 dark:border-emerald-900/30">
                    <h3 class="font-bold text-emerald-800 dark:text-emerald-300">Hospital de Salud Mental (VSA)</h3>
                    <p class="text-emerald-700 dark:text-emerald-400/80 text-sm mb-2">Urgencias psicológicas y psiquiátricas.</p>
                    <p class="text-xs font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-100/50 dark:bg-emerald-900/50 p-2 rounded-lg inline-block">📍 Av. 16 de Septiembre, Col. El Recreo.</p>
                </div>
            </div>
        </div>
    </div>

    <nav class="hidden md:flex flex-col w-64 bg-white/80 dark:bg-stone-950/80 backdrop-blur-md border-r border-stone-200/50 dark:border-stone-800 h-screen fixed sticky top-0 p-6 space-y-2 z-40 shadow-sm transition-colors">
        <div class="flex items-center space-x-3 mb-10 text-amber-700 dark:text-amber-500 mt-4">
            <i data-lucide="heart" class="w-8 h-8 fill-amber-200 dark:fill-amber-900 text-amber-500"></i>
            <div>
                <h1 class="text-2xl font-bold font-serif leading-none dark:text-stone-100">Mi Refugio</h1>
                <p class="text-[10px] uppercase tracking-wider text-stone-400 dark:text-stone-500 font-bold mt-1">Tabasco</p>
            </div>
        </div>
        <button onclick="switchTab('home')" id="nav-home" class="nav-btn-desktop flex items-center space-x-3 w-full p-3.5 rounded-2xl transition-all duration-300 bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300 font-bold shadow-sm translate-x-2">
            <i data-lucide="home" class="w-5 h-5 nav-icon-desktop text-amber-600 dark:text-amber-400"></i><span>Inicio</span>
        </button>
        <button onclick="switchTab('rio')" id="nav-rio" class="nav-btn-desktop flex items-center space-x-3 w-full p-3.5 rounded-2xl transition-all duration-300 text-stone-500 dark:text-stone-400 hover:bg-cyan-50 dark:hover:bg-cyan-900/20 hover:text-cyan-700 dark:hover:text-cyan-400">
            <i data-lucide="droplets" class="w-5 h-5 nav-icon-desktop"></i><span>El Río</span>
        </button>
        <button onclick="switchTab('macuili')" id="nav-macuili" class="nav-btn-desktop flex items-center space-x-3 w-full p-3.5 rounded-2xl transition-all duration-300 text-stone-500 dark:text-stone-400 hover:bg-pink-50 dark:hover:bg-pink-900/20 hover:text-pink-700 dark:hover:text-pink-400">
            <i data-lucide="leaf" class="w-5 h-5 nav-icon-desktop"></i><span>El Macuilí</span>
        </button>
        <button onclick="switchTab('ceiba')" id="nav-ceiba" class="nav-btn-desktop flex items-center space-x-3 w-full p-3.5 rounded-2xl transition-all duration-300 text-stone-500 dark:text-stone-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 hover:text-emerald-700 dark:hover:text-emerald-400">
            <i data-lucide="wind" class="w-5 h-5 nav-icon-desktop"></i><span>La Ceiba</span>
        </button>
    </nav>

    <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-white/90 dark:bg-stone-900/90 backdrop-blur-lg border-t border-stone-200/50 dark:border-stone-800 flex justify-around p-2 z-40 pb-safe shadow-[0_-10px_20px_rgba(0,0,0,0.03)] dark:shadow-[0_-10px_20px_rgba(0,0,0,0.3)] rounded-t-3xl transition-colors">
        <button onclick="switchTab('home')" id="mob-home" class="nav-btn-mobile flex flex-col items-center justify-center w-full p-2 space-y-1 transition-all duration-300 text-amber-700 dark:text-amber-400 -translate-y-1">
            <div class="p-2 rounded-xl transition-colors mob-bg bg-amber-100 dark:bg-amber-900/40">
                <i data-lucide="home" class="w-6 h-6 mob-icon fill-amber-200 dark:fill-amber-900 text-amber-600 dark:text-amber-400"></i>
            </div>
            <span class="text-[10px] font-bold mob-text">Inicio</span>
        </button>
        <button onclick="switchTab('rio')" id="mob-rio" class="nav-btn-mobile flex flex-col items-center justify-center w-full p-2 space-y-1 transition-all duration-300 text-stone-400 dark:text-stone-500 hover:text-stone-600 dark:hover:text-stone-300">
            <div class="p-2 rounded-xl transition-colors mob-bg bg-transparent">
                <i data-lucide="droplets" class="w-6 h-6 mob-icon"></i>
            </div>
            <span class="text-[10px] font-medium mob-text">El Río</span>
        </button>
        <button onclick="switchTab('macuili')" id="mob-macuili" class="nav-btn-mobile flex flex-col items-center justify-center w-full p-2 space-y-1 transition-all duration-300 text-stone-400 dark:text-stone-500 hover:text-stone-600 dark:hover:text-stone-300">
            <div class="p-2 rounded-xl transition-colors mob-bg bg-transparent">
                <i data-lucide="leaf" class="w-6 h-6 mob-icon"></i>
            </div>
            <span class="text-[10px] font-medium mob-text">Macuilí</span>
        </button>
        <button onclick="switchTab('ceiba')" id="mob-ceiba" class="nav-btn-mobile flex flex-col items-center justify-center w-full p-2 space-y-1 transition-all duration-300 text-stone-400 dark:text-stone-500 hover:text-stone-600 dark:hover:text-stone-300">
            <div class="p-2 rounded-xl transition-colors mob-bg bg-transparent">
                <i data-lucide="wind" class="w-6 h-6 mob-icon"></i>
            </div>
            <span class="text-[10px] font-medium mob-text">Ceiba</span>
        </button>
    </nav>

    <main class="flex-1 w-full max-w-2xl mx-auto p-6 md:p-10 relative z-10" id="main-content">
        
        <section id="sec-home" class="space-y-8 pt-4 transition-opacity duration-500 opacity-100">
            <header class="space-y-2 text-center md:text-left">
                <h1 class="text-3xl md:text-4xl font-bold text-amber-900 dark:text-amber-400 font-serif">Pásale, estás en tu casa.</h1>
                <p class="text-lg text-amber-700/80 dark:text-amber-200/60">Este es tu refugio seguro, libre de juicios, básculas y espejos.</p>
            </header>

            <div class="bg-white dark:bg-stone-900 rounded-[2rem] p-6 shadow-sm border border-amber-100/50 dark:border-stone-800 transition-colors">
                <h2 class="text-xl font-bold mb-4 text-stone-800 dark:text-stone-200 text-center">Dime la verdad, ¿cómo anda tu corazón hoy?</h2>
                <div class="flex justify-center gap-4 mb-6">
                    <button onclick="setMood('mal')" id="mood-mal" class="mood-btn flex flex-col items-center p-3 rounded-2xl transition-all hover:bg-stone-50 dark:hover:bg-stone-800 grayscale hover:grayscale-0">
                        <div class="w-14 h-14 bg-red-100 dark:bg-red-900/40 rounded-full flex items-center justify-center text-red-500 dark:text-red-400 mb-2 shadow-sm"><i data-lucide="frown" class="w-8 h-8"></i></div>
                        <span class="text-sm font-medium text-stone-600 dark:text-stone-400">Ansioso/Triste</span>
                    </button>
                    <button onclick="setMood('meh')" id="mood-meh" class="mood-btn flex flex-col items-center p-3 rounded-2xl transition-all hover:bg-stone-50 dark:hover:bg-stone-800 grayscale hover:grayscale-0">
                        <div class="w-14 h-14 bg-orange-100 dark:bg-orange-900/40 rounded-full flex items-center justify-center text-orange-500 dark:text-orange-400 mb-2 shadow-sm"><i data-lucide="meh" class="w-8 h-8"></i></div>
                        <span class="text-sm font-medium text-stone-600 dark:text-stone-400">Apurado/Confuso</span>
                    </button>
                    <button onclick="setMood('bien')" id="mood-bien" class="mood-btn flex flex-col items-center p-3 rounded-2xl transition-all hover:bg-stone-50 dark:hover:bg-stone-800 grayscale hover:grayscale-0">
                        <div class="w-14 h-14 bg-emerald-100 dark:bg-emerald-900/40 rounded-full flex items-center justify-center text-emerald-500 dark:text-emerald-400 mb-2 shadow-sm"><i data-lucide="smile" class="w-8 h-8"></i></div>
                        <span class="text-sm font-medium text-stone-600 dark:text-stone-400">Ahí la llevo</span>
                    </button>
                </div>

                <div id="mood-recommendation" class="hidden bg-amber-50 dark:bg-amber-950/50 rounded-2xl p-4 text-center border border-amber-100 dark:border-amber-900/50 transition-all duration-300">
                    <p id="mood-text" class="text-stone-700 dark:text-stone-300"></p>
                </div>
            </div>

            <div class="relative bg-gradient-to-br from-amber-800 to-amber-950 dark:from-stone-800 dark:to-stone-900 text-amber-50 rounded-[2rem] p-8 shadow-lg overflow-hidden group border dark:border-stone-700">
                <i data-lucide="sparkles" class="absolute top-4 right-4 text-amber-500/30 dark:text-amber-400/20 w-16 h-16 animate-pulse transition-transform group-hover:scale-110"></i>
                <div class="relative z-10">
                    <p class="text-xs font-bold uppercase tracking-widest text-amber-300 dark:text-amber-500 mb-3 flex items-center gap-2">Pozolito para el Alma <span>☕</span></p>
                    <p class="text-xl md:text-2xl font-serif leading-relaxed italic dark:text-stone-200" id="frase-dia">"No te compares. Hasta el Grijalva y el Usumacinta tienen corrientes distintas, y ambos son hermosos."</p>
                </div>
            </div>
        </section>

        <section id="sec-rio" class="hidden flex flex-col items-center justify-center min-h-[80vh] pt-8 transition-opacity duration-500 opacity-0">
            <div class="w-20 h-20 bg-cyan-100 dark:bg-cyan-900/40 rounded-full flex items-center justify-center mb-6 animate-float shadow-inner border border-cyan-200 dark:border-cyan-800 transition-colors">
                <i data-lucide="droplets" class="w-10 h-10 text-cyan-600 dark:text-cyan-400"></i>
            </div>
            <h2 class="text-3xl font-bold text-cyan-900 dark:text-cyan-400 font-serif mb-2 text-center">El Río Grijalva</h2>
            <p class="text-cyan-700 dark:text-cyan-300/80 text-center mb-8 px-4 max-w-md">Escribe aquí ese pensamiento que te atormenta (sobre la comida, la culpa o tu cuerpo). Luego, deja que la corriente se lo lleve.</p>

            <div class="w-full max-w-md relative">
                <textarea 
                    id="rio-textarea"
                    oninput="checkRioText()"
                    placeholder="Tengo miedo de que..."
                    class="w-full h-40 p-5 rounded-3xl bg-white/60 dark:bg-stone-900/80 backdrop-blur-sm border-2 border-cyan-100 dark:border-cyan-900/50 focus:border-cyan-300 dark:focus:border-cyan-600 focus:outline-none resize-none text-cyan-900 dark:text-cyan-100 shadow-sm transition-all text-lg placeholder:text-cyan-300/80 dark:placeholder:text-cyan-700/80"
                ></textarea>
                
                <button 
                    id="rio-btn"
                    onclick="soltarEnRio()"
                    disabled
                    class="absolute -bottom-6 left-1/2 -translate-x-1/2 px-6 py-3 rounded-full font-bold flex items-center gap-2 transition-all shadow-lg bg-stone-300 dark:bg-stone-800 text-stone-500 dark:text-stone-500 cursor-not-allowed border dark:border-stone-700"
                >
                    <i data-lucide="send" class="w-5 h-5"></i>
                    <span>Soltar en la corriente</span>
                </button>
            </div>
            <p id="rio-calma" class="mt-12 text-sm text-cyan-600/60 dark:text-cyan-400/60 font-medium animate-pulse">El agua está en calma...</p>
        </section>

        <section id="sec-macuili" class="hidden relative min-h-[85vh] overflow-hidden rounded-[3rem] bg-gradient-to-b from-pink-50 to-pink-100 dark:from-stone-900 dark:to-pink-950/20 flex flex-col items-center justify-center p-6 mt-4 shadow-sm border border-pink-100 dark:border-pink-900/30 transition-all duration-500 opacity-0">
            <div class="z-10 text-center mb-10 pointer-events-none">
                <h2 class="text-3xl font-bold text-pink-900 dark:text-pink-400 font-serif mb-2">Bajo el Macuilí</h2>
                <p class="text-pink-700 dark:text-pink-300/80 max-w-xs mx-auto">Toca un pétalo de macuilí cayendo para recibir un apapacho sorpresa.</p>
            </div>

            <div class="z-20 w-full max-w-sm h-48 flex items-center justify-center">
                <div id="macuili-waiting" class="w-full h-full border-2 border-dashed border-pink-300/50 dark:border-pink-800/50 rounded-3xl flex items-center justify-center text-pink-400/50 dark:text-pink-500/50 font-medium transition-opacity">
                    Esperando un pétalo...
                </div>
                
                <div id="macuili-message-box" class="hidden absolute bg-white/95 dark:bg-stone-800/95 backdrop-blur-md p-8 rounded-3xl shadow-xl text-center border border-pink-100 dark:border-stone-700 w-full max-w-sm transform scale-95 opacity-0 transition-all duration-300 group">
                    <button onclick="cerrarMensajeMacuili()" class="absolute top-3 right-3 text-pink-300 dark:text-stone-500 hover:text-pink-500 dark:hover:text-pink-400 transition-colors p-1"><i data-lucide="x" class="w-5 h-5"></i></button>
                    <i data-lucide="sparkles" class="w-6 h-6 text-pink-400 dark:text-pink-500 mx-auto mb-3"></i>
                    <p id="macuili-text" class="text-lg font-medium text-pink-900 dark:text-pink-100 leading-relaxed italic"></p>
                </div>
            </div>

            <div id="petals-container" class="absolute inset-0 overflow-hidden pointer-events-none"></div>
        </section>

        <section id="sec-ceiba" class="hidden h-full flex flex-col items-center justify-center space-y-12 pt-8 transition-opacity duration-500 opacity-0 min-h-[80vh]">
            <div class="text-center space-y-2">
                <h2 class="text-3xl font-bold text-emerald-900 dark:text-emerald-400 font-serif">La Raíz de la Ceiba</h2>
                <p class="text-emerald-700/80 dark:text-emerald-200/60 px-4">Si sientes que pierdes el control, ven aquí. Respira con el ritmo del círculo.</p>
            </div>

            <div class="relative w-64 h-64 flex items-center justify-center mt-12 mb-8 cursor-pointer group" onclick="toggleRespiracion()">
                <div id="ring-1" class="absolute w-32 h-32 bg-emerald-200/40 dark:bg-emerald-500/20 rounded-full blur-sm scale-100 opacity-50 transition-all duration-[4000ms] ease-in-out"></div>
                <div id="ring-2" class="absolute w-40 h-40 border border-emerald-300/30 dark:border-emerald-500/20 rounded-full scale-100 opacity-50 transition-all duration-[4000ms] ease-in-out delay-75"></div>
                <div id="ring-3" class="absolute w-48 h-48 border border-emerald-200/20 dark:border-emerald-500/10 rounded-full scale-100 opacity-50 transition-all duration-[4000ms] ease-in-out delay-150"></div>
                
                <button id="btn-respirar" class="absolute w-32 h-32 bg-emerald-600 dark:bg-emerald-700 hover:bg-emerald-500 dark:hover:bg-emerald-600 rounded-full shadow-xl shadow-emerald-600/30 dark:shadow-emerald-900/50 flex items-center justify-center text-white text-center p-4 font-medium transition-transform group-hover:scale-105 group-active:scale-95 z-10 border border-emerald-500 dark:border-emerald-600">
                    Toca para<br>empezar
                </button>
            </div>

            <div class="w-full max-w-md bg-white dark:bg-stone-900 rounded-3xl p-6 shadow-sm border border-emerald-100 dark:border-stone-800 mt-8 transition-colors">
                <h3 class="font-bold text-emerald-800 dark:text-emerald-400 mb-4 flex items-center gap-2"><i data-lucide="wind" class="w-5 h-5"></i> Técnicas Rápidas (Choque)</h3>
                <ul class="space-y-4">
                    <li class="flex gap-3 text-sm text-stone-600 dark:text-stone-300 bg-emerald-50/50 dark:bg-emerald-900/20 p-3 rounded-2xl border border-emerald-50 dark:border-emerald-900/30">
                        <span class="text-xl">🧊</span>
                        <div><strong class="dark:text-emerald-300">El Hielo:</strong> Ve a la cocina, toma un hielo y apriétalo en tus manos. El cambio extremo de temperatura resetea tu sistema nervioso.</div>
                    </li>
                    <li class="flex gap-3 text-sm text-stone-600 dark:text-stone-300 bg-emerald-50/50 dark:bg-emerald-900/20 p-3 rounded-2xl border border-emerald-50 dark:border-emerald-900/30">
                        <span class="text-xl">🍋</span>
                        <div><strong class="dark:text-emerald-300">Sabor Fuerte:</strong> Muerde un limón o chupa un dulce muy ácido. Ayuda a traer tu cerebro de vuelta al presente.</div>
                    </li>
                </ul>
            </div>
        </section>

    </main>

    <script>
        lucide.createIcons();

        // --- LÓGICA DE MODO OSCURO ---
        function toggleTheme() {
            const htmlElement = document.documentElement;
            htmlElement.classList.toggle('dark');
            
            const themeIcon = document.getElementById('theme-icon');
            if (htmlElement.classList.contains('dark')) {
                themeIcon.setAttribute('data-lucide', 'sun');
            } else {
                themeIcon.setAttribute('data-lucide', 'moon');
            }
            lucide.createIcons();
        }

        // --- NAVEGACIÓN Y TABS ---
        const sections = ['home', 'rio', 'macuili', 'ceiba'];
        
        // Colores base con sus contrapartes oscuras
        const bodyColors = {
            'home': 'bg-amber-50 dark:bg-stone-950',
            'rio': 'bg-cyan-50 dark:bg-stone-950',
            'macuili': 'bg-pink-50 dark:bg-stone-950',
            'ceiba': 'bg-emerald-50 dark:bg-stone-950'
        };

        function switchTab(targetId) {
            const body = document.getElementById('main-body');
            body.className = `font-sans text-stone-800 dark:text-stone-200 antialiased min-h-screen flex flex-col md:flex-row pb-20 md:pb-0 transition-colors duration-700 ${bodyColors[targetId]}`;

            sections.forEach(sec => {
                const el = document.getElementById(`sec-${sec}`);
                el.classList.remove('opacity-100');
                el.classList.add('opacity-0');
                setTimeout(() => {
                    if (sec !== targetId) el.classList.add('hidden');
                }, 300);
            });

            setTimeout(() => {
                const targetEl = document.getElementById(`sec-${targetId}`);
                targetEl.classList.remove('hidden');
                setTimeout(() => {
                    targetEl.classList.remove('opacity-0');
                    targetEl.classList.add('opacity-100');
                }, 50);
            }, 300);

            updateNavDesktop(targetId);
            updateNavMobile(targetId);

            if(targetId === 'macuili') generarPetalos();
        }

        function updateNavDesktop(activeId) {
            const colors = { home: 'amber', rio: 'cyan', macuili: 'pink', ceiba: 'emerald' };
            
            sections.forEach(sec => {
                const btn = document.getElementById(`nav-${sec}`);
                const icon = btn.querySelector('.nav-icon-desktop');
                const c = colors[sec];

                if (sec === activeId) {
                    btn.className = `nav-btn-desktop flex items-center space-x-3 w-full p-3.5 rounded-2xl transition-all duration-300 bg-${c}-100 dark:bg-${c}-900/40 text-${c}-800 dark:text-${c}-300 font-bold shadow-sm translate-x-2`;
                    icon.classList.add(`text-${c}-600`, `dark:text-${c}-400`);
                } else {
                    btn.className = `nav-btn-desktop flex items-center space-x-3 w-full p-3.5 rounded-2xl transition-all duration-300 text-stone-500 dark:text-stone-400 hover:bg-${c}-50 dark:hover:bg-stone-800 hover:text-${c}-700 dark:hover:text-${c}-300`;
                    icon.className = 'w-5 h-5 nav-icon-desktop';
                }
            });
        }

        function updateNavMobile(activeId) {
            const colors = { home: 'amber', rio: 'cyan', macuili: 'pink', ceiba: 'emerald' };

            sections.forEach(sec => {
                const btn = document.getElementById(`mob-${sec}`);
                const bg = btn.querySelector('.mob-bg');
                const icon = btn.querySelector('.mob-icon');
                const text = btn.querySelector('.mob-text');
                const c = colors[sec];

                if (sec === activeId) {
                    btn.className = `nav-btn-mobile flex flex-col items-center justify-center w-full p-2 space-y-1 transition-all duration-300 text-${c}-700 dark:text-${c}-400 -translate-y-1`;
                    bg.className = `p-2 rounded-xl transition-colors mob-bg bg-${c}-100 dark:bg-${c}-900/40`;
                    icon.className = `mob-icon w-6 h-6 fill-${c}-200 dark:fill-${c}-900 text-${c}-600 dark:text-${c}-400 lucide lucide-${icon.getAttribute('data-lucide')}`;
                    text.className = 'text-[10px] font-bold mob-text';
                } else {
                    btn.className = `nav-btn-mobile flex flex-col items-center justify-center w-full p-2 space-y-1 transition-all duration-300 text-stone-400 dark:text-stone-500 hover:text-stone-600 dark:hover:text-stone-300`;
                    bg.className = `p-2 rounded-xl transition-colors mob-bg bg-transparent`;
                    icon.className = `mob-icon w-6 h-6 lucide lucide-${icon.getAttribute('data-lucide')}`;
                    text.className = 'text-[10px] font-medium mob-text';
                }
            });
        }

        // --- LÓGICA: MODAL SOS ---
        function toggleSosModal(show) {
            const modal = document.getElementById('sos-modal');
            const content = document.getElementById('sos-content');
            
            if (show) {
                modal.classList.remove('hidden');
                setTimeout(() => {
                    modal.classList.add('opacity-100');
                    content.classList.remove('scale-95', 'opacity-0');
                    content.classList.add('scale-100', 'opacity-100');
                }, 10);
            } else {
                content.classList.remove('scale-100', 'opacity-100');
                content.classList.add('scale-95', 'opacity-0');
                modal.classList.remove('opacity-100');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            }
        }

        // --- LÓGICA: INICIO (Termómetro) ---
        function setMood(mood) {
            const btnMal = document.getElementById('mood-mal');
            const btnMeh = document.getElementById('mood-meh');
            const btnBien = document.getElementById('mood-bien');
            const recBox = document.getElementById('mood-recommendation');
            const recText = document.getElementById('mood-text');

            [btnMal, btnMeh, btnBien].forEach(btn => {
                btn.className = 'mood-btn flex flex-col items-center p-3 rounded-2xl transition-all hover:bg-stone-50 dark:hover:bg-stone-800 grayscale hover:grayscale-0 cursor-pointer';
            });

            if (mood === 'mal') {
                btnMal.classList.remove('hover:bg-stone-50', 'dark:hover:bg-stone-800', 'grayscale', 'hover:grayscale-0');
                btnMal.classList.add('bg-red-50', 'dark:bg-red-900/20', 'scale-110', 'shadow-sm');
                recText.innerHTML = 'Te entiendo. Esa sensación es abrumadora. Te recomiendo ir a <strong class="text-red-700 dark:text-red-400 cursor-pointer hover:underline" onclick="switchTab(\'rio\')">"El Río"</strong> para soltar esos pensamientos, o a <strong class="text-red-700 dark:text-red-400 cursor-pointer hover:underline" onclick="switchTab(\'ceiba\')">"La Ceiba"</strong> para calmar tu pecho.';
            } else if (mood === 'meh') {
                btnMeh.classList.remove('hover:bg-stone-50', 'dark:hover:bg-stone-800', 'grayscale', 'hover:grayscale-0');
                btnMeh.classList.add('bg-orange-50', 'dark:bg-orange-900/20', 'scale-110', 'shadow-sm');
                recText.innerHTML = 'Es normal tener días grises. Ve a atrapar unos pétalos a <strong class="text-orange-700 dark:text-orange-400 cursor-pointer hover:underline" onclick="switchTab(\'macuili\')">"El Macuilí"</strong>, te prometo que te sacará una sonrisa.';
            } else if (mood === 'bien') {
                btnBien.classList.remove('hover:bg-stone-50', 'dark:hover:bg-stone-800', 'grayscale', 'hover:grayscale-0');
                btnBien.classList.add('bg-emerald-50', 'dark:bg-emerald-900/20', 'scale-110', 'shadow-sm');
                recText.innerHTML = '¡Qué alegría! Celebra las pequeñas victorias. Sigue explorando las herramientas para fortalecerte.';
            }

            recBox.classList.remove('hidden');
            setTimeout(() => {
                recBox.classList.add('opacity-100', 'scale-100');
            }, 10);
        }

        // --- LÓGICA: EL RÍO ---
        function checkRioText() {
            const text = document.getElementById('rio-textarea').value;
            const btn = document.getElementById('rio-btn');
            
            if (text.trim().length > 0) {
                btn.disabled = false;
                btn.className = "absolute -bottom-6 left-1/2 -translate-x-1/2 px-6 py-3 rounded-full font-bold flex items-center gap-2 transition-all shadow-lg bg-cyan-600 dark:bg-cyan-700 text-white hover:bg-cyan-700 dark:hover:bg-cyan-600 hover:scale-105 active:scale-95 border dark:border-cyan-600";
            } else {
                btn.disabled = true;
                btn.className = "absolute -bottom-6 left-1/2 -translate-x-1/2 px-6 py-3 rounded-full font-bold flex items-center gap-2 transition-all shadow-lg bg-stone-300 dark:bg-stone-800 text-stone-500 dark:text-stone-500 cursor-not-allowed border dark:border-stone-700";
            }
        }

        function soltarEnRio() {
            const textarea = document.getElementById('rio-textarea');
            const btn = document.getElementById('rio-btn');
            const calmaText = document.getElementById('rio-calma');

            if(textarea.value.trim() === '') return;

            textarea.disabled = true;
            btn.disabled = true;
            calmaText.classList.add('hidden');
            
            btn.className = "absolute -bottom-6 left-1/2 -translate-x-1/2 px-6 py-3 rounded-full font-bold flex items-center gap-2 shadow-lg bg-cyan-800 dark:bg-cyan-900 text-cyan-200 cursor-not-allowed border dark:border-cyan-800";
            btn.innerHTML = '<i data-lucide="loader" class="w-5 h-5 animate-spin"></i><span>Soltando...</span>';
            lucide.createIcons();

            textarea.classList.add('animate-wash');

            setTimeout(() => {
                textarea.value = '';
                textarea.disabled = false;
                textarea.classList.remove('animate-wash');
                checkRioText();
                btn.innerHTML = '<i data-lucide="send" class="w-5 h-5"></i><span>Soltar en la corriente</span>';
                lucide.createIcons();
                calmaText.classList.remove('hidden');
            }, 2000);
        }

        // --- LÓGICA: EL MACUILÍ ---
        const apapachos = [
            "Mereces ocupar espacio en este mundo.",
            "La comida no tiene moral. No eres 'mala' por comer algo rico.",
            "Tu cuerpo hace cosas increíbles todos los días por ti.",
            "Está bien pedir ayuda. Está bien descansar.",
            "Ese número en la báscula no sabe nada sobre lo bonita que es tu risa.",
            "Sanar no es lineal. Hoy fue difícil, pero mañana sale el sol otra vez."
        ];
        let petalosGenerados = false;

        function generarPetalos() {
            if(petalosGenerados) return;
            const container = document.getElementById('petals-container');
            for(let i=0; i<15; i++) {
                const petal = document.createElement('div');
                petal.className = 'petal pointer-events-auto drop-shadow-sm';
                petal.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform rotate-45"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`;
                const left = Math.random() * 90;
                const duration = Math.random() * 6 + 6;
                const delay = Math.random() * 5;
                const size = Math.random() * 1.5 + 1;

                petal.style.left = `${left}%`;
                petal.style.animationDuration = `${duration}s`;
                petal.style.animationDelay = `${delay}s`;
                petal.style.width = `${size}rem`;
                petal.style.height = `${size}rem`;
                petal.onclick = atraparPetalo;
                container.appendChild(petal);
            }
            petalosGenerados = true;
        }

        function atraparPetalo() {
            const waiting = document.getElementById('macuili-waiting');
            const msgBox = document.getElementById('macuili-message-box');
            const msgText = document.getElementById('macuili-text');

            msgBox.classList.remove('scale-100', 'opacity-100');
            msgBox.classList.add('scale-95', 'opacity-0');

            setTimeout(() => {
                waiting.classList.add('hidden');
                msgBox.classList.remove('hidden');
                const frase = apapachos[Math.floor(Math.random() * apapachos.length)];
                msgText.textContent = `"${frase}"`;
                setTimeout(() => {
                    msgBox.classList.remove('scale-95', 'opacity-0');
                    msgBox.classList.add('scale-100', 'opacity-100');
                }, 50);
            }, 200);
        }

        function cerrarMensajeMacuili() {
            const waiting = document.getElementById('macuili-waiting');
            const msgBox = document.getElementById('macuili-message-box');
            msgBox.classList.remove('scale-100', 'opacity-100');
            msgBox.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                msgBox.classList.add('hidden');
                waiting.classList.remove('hidden');
            }, 300);
        }

        // --- LÓGICA: LA CEIBA (Respiración) ---
        let respInterval;
        let isBreathing = false;
        let phaseIndex = 0;
        const phases = ['Inhala profundo...', 'Sostén...', 'Exhala suavemente...'];

        function toggleRespiracion() {
            const btn = document.getElementById('btn-respirar');
            const r1 = document.getElementById('ring-1');
            const r2 = document.getElementById('ring-2');
            const r3 = document.getElementById('ring-3');

            if (!isBreathing) {
                isBreathing = true;
                phaseIndex = 0;
                btn.textContent = phases[phaseIndex];
                btn.className = "absolute w-32 h-32 bg-emerald-600 dark:bg-emerald-700 rounded-full shadow-xl shadow-emerald-600/30 dark:shadow-emerald-900/50 flex items-center justify-center text-white text-center p-4 font-bold z-10 transition-colors border border-emerald-500 dark:border-emerald-600";
                
                aplicarEstiloAnillos(r1, r2, r3, phaseIndex);

                respInterval = setInterval(() => {
                    phaseIndex = (phaseIndex + 1) % 3;
                    btn.textContent = phases[phaseIndex];
                    aplicarEstiloAnillos(r1, r2, r3, phaseIndex);
                }, 4000);

            } else {
                isBreathing = false;
                clearInterval(respInterval);
                btn.innerHTML = "Toca para<br>empezar";
                btn.className = "absolute w-32 h-32 bg-emerald-600 dark:bg-emerald-700 hover:bg-emerald-500 dark:hover:bg-emerald-600 rounded-full shadow-xl shadow-emerald-600/30 dark:shadow-emerald-900/50 flex items-center justify-center text-white text-center p-4 font-medium transition-transform group-hover:scale-105 group-active:scale-95 z-10 border border-emerald-500 dark:border-emerald-600";
                
                [r1, r2, r3].forEach(r => {
                    r.classList.remove('scale-[2.5]', 'opacity-100', 'opacity-80');
                    r.classList.add('scale-100', 'opacity-50');
                });
            }
        }

        function aplicarEstiloAnillos(r1, r2, r3, phase) {
            const anillos = [r1, r2, r3];
            if (phase === 0) { 
                anillos.forEach(r => {
                    r.classList.remove('scale-100', 'opacity-50', 'opacity-80');
                    r.classList.add('scale-[2.5]', 'opacity-100');
                });
            } else if (phase === 1) { 
                anillos.forEach(r => {
                    r.classList.remove('opacity-100');
                    r.classList.add('opacity-80');
                });
            } else if (phase === 2) { 
                anillos.forEach(r => {
                    r.classList.remove('scale-[2.5]', 'opacity-80', 'opacity-100');
                    r.classList.add('scale-100', 'opacity-50');
                });
            }
        }

    </script>
</body>
</html>